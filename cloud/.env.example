HUE_CLIENT_ID=
HUE_CLIENT_SECRET=
HUE_APP_ID=
HUE_USERNAME=
VISUAL_CROSSING_API_KEY=
# Shared worker: verified-TLS database URL with limited token-table login.
# HUE_DATABASE_URL=
# Initial JSON generated by npm run authorize (never commit real credentials).
HUE_TOKENS_JSON=
HUE_TOKEN_FILE=./data/hue.tokens.json
DRY_RUN=true
POLL_SECONDS=30
WEATHER_POLL_SECONDS=300
WEATHER_MAX_AGE_SECONDS=1800
